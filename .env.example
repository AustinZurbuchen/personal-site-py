# MongoDB Atlas credentials for the personalsite cluster.
DBUSER=
DBPASS=

# Signs admin session tokens. REQUIRED for /session and /updateResume — with it
# unset or shorter than 32 characters both routes return 503 rather than
# running unauthenticated. Rotating it logs every session out immediately.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=

# ADMIN_TOKEN is GONE. The static shared secret was replaced by a real login
# issuing a signed, expiring session token; keeping it alongside would have
# meant the door's real strength was a non-expiring string in this file.
# Remove it from the container's variables.
