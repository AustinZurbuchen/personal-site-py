# MongoDB Atlas credentials for the personalsite cluster.
DBUSER=
DBPASS=

# Shared secret for write endpoints, sent as: Authorization: Bearer <token>
# Required by PUT /updateTest. If unset, write routes return 503 rather than
# running unauthenticated — do not "fix" a 503 by removing the guard.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
