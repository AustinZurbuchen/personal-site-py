# Secrets — must never be baked into an image layer. Supplied at runtime
# instead, via docker-compose's env_file (or --env-file / -e).
.env
.env.*

# VCS and tooling
.git
.gitignore
.dockerignore
.claude/

# Tests and dev tooling never ship in the image
test_*.py
requirements-dev.txt

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local virtualenvs
.venv/
venv/
ENV/

# Docs and editor cruft — not needed at runtime
*.md
.DS_Store
